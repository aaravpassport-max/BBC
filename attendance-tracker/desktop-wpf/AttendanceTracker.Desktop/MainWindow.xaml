<Window x:Class="AttendanceTracker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AttendanceTracker.Desktop.Views"
        Title="Workforce Attendance"
        Height="820" Width="1280" MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen">
  <Grid x:Name="RootGrid">
    <!-- Main shell: visible immediately with live read-only data -->
    <Grid x:Name="ShellGrid" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource OfficeSurfaceBrush}" BorderBrush="{StaticResource OfficeBorderBrush}" BorderThickness="0,0,0,1">
        <DockPanel Margin="16,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="28" Height="28" CornerRadius="4" Background="{StaticResource OfficeAccentBrush}" Margin="0,0,10,0">
              <TextBlock Text="A" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Workforce Attendance" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
            <TextBlock x:Name="SignedInLabel" Foreground="{StaticResource OfficeMutedBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button x:Name="AdminSignInButton" Content="Admin sign in" Style="{StaticResource OfficeSecondaryButton}" Click="AdminSignIn_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button x:Name="ExitAdminButton" Content="Exit admin mode" Style="{StaticResource OfficeSecondaryButton}" Click="SignOut_Click" Padding="12,6" Visibility="Collapsed"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource OfficeSurfaceBrush}" BorderBrush="{StaticResource OfficeBorderBrush}" BorderThickness="0,0,1,0">
          <StackPanel Margin="8,16,8,16">
            <TextBlock Text="Home" Foreground="{StaticResource OfficeMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="12,0,0,8"/>
            <Button x:Name="NavDashboard" Content="Dashboard" Style="{StaticResource OfficeNavButtonSelected}" Click="Nav_Click" Tag="dashboard"/>
            <Button x:Name="NavEmployees" Content="Employees" Style="{StaticResource OfficeNavButton}" Click="Nav_Click" Tag="employees"/>
            <Button x:Name="NavHistory" Content="Attendance history" Style="{StaticResource OfficeNavButton}" Click="Nav_Click" Tag="history"/>
            <Button x:Name="NavReports" Content="Reports &amp; export" Style="{StaticResource OfficeNavButton}" Click="Nav_Click" Tag="reports"/>
            <Button x:Name="NavCorrections" Content="Correction requests" Style="{StaticResource OfficeNavButton}" Click="Nav_Click" Tag="corrections"/>
            <Button x:Name="NavEmployeesGuide" Content="Browser extension" Style="{StaticResource OfficeNavButton}" Click="Nav_Click" Tag="employee-guide"/>
            <Button x:Name="NavSettings" Content="Settings" Style="{StaticResource OfficeNavButton}" Click="Nav_Click" Tag="settings"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Padding="24,20">
          <ContentControl x:Name="MainContent"/>
        </Border>
      </Grid>
    </Grid>

    <!-- Startup / errors -->
    <Border x:Name="StartupPanel" Background="{StaticResource OfficeBgBrush}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
        <TextBlock Text="Starting Workforce Attendance…" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="StartupStatusText" Foreground="{StaticResource OfficeMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Admin sign-in overlay -->
    <Grid x:Name="LoginOverlay" Visibility="Collapsed" Background="#AA000000">
      <views:LoginView x:Name="LoginPanel"/>
    </Grid>
  </Grid>
</Window>
