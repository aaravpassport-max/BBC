<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>AttendanceTracker</AssemblyName>
    <RootNamespace>AttendanceTracker.Desktop</RootNamespace>
    <Version>1.1.0</Version>
    <Company>Attendance Tracker</Company>
    <Product>Workforce Attendance</Product>
    <Description>Unified Windows app for workforce attendance — live data for everyone, admin sign-in for changes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\agent-windows\AgentDatabaseBootstrap.cs" Link="Monitoring\AgentDatabaseBootstrap.cs" />
    <Compile Include="..\..\agent-windows\AgentInstallConfig.cs" Link="Monitoring\AgentInstallConfig.cs" />
    <Compile Include="..\..\agent-windows\AgentStartupError.cs" Link="Monitoring\AgentStartupError.cs" />
    <Compile Include="..\..\agent-windows\EventSyncClient.cs" Link="Monitoring\EventSyncClient.cs" />
    <Compile Include="..\..\agent-windows\EventType.cs" Link="Monitoring\EventType.cs" />
    <Compile Include="..\..\agent-windows\InputHook.cs" Link="Monitoring\InputHook.cs" />
    <Compile Include="..\..\agent-windows\NoticeForm.cs" Link="Monitoring\NoticeForm.cs" />
    <Compile Include="..\..\agent-windows\SessionMonitor.cs" Link="Monitoring\SessionMonitor.cs" />
    <Compile Include="..\..\agent-windows\SqliteRepository.cs" Link="Monitoring\SqliteRepository.cs" />
    <Compile Include="..\..\agent-windows\TrayPresence.cs" Link="Monitoring\TrayPresence.cs" />
    <Compile Include="..\..\agent-windows\UsageIngestPipeServer.cs" Link="Monitoring\UsageIngestPipeServer.cs" />
  </ItemGroup>

</Project>
