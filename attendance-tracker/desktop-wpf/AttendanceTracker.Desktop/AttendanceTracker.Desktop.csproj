<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>AttendanceTracker</AssemblyName>
    <RootNamespace>AttendanceTracker.Desktop</RootNamespace>
    <Version>1.0.0</Version>
    <Company>Attendance Tracker</Company>
    <Product>Workforce Attendance Console</Product>
    <Description>Native Windows administration console for workforce attendance, activity, and reporting.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
