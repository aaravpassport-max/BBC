<UserControl x:Class="AttendanceTracker.Desktop.Views.CorrectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Correction requests" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <TextBlock Text="Review employee-submitted attendance corrections. Approvals write audited correction rows." Foreground="{StaticResource OfficeMutedBrush}" Margin="0,0,0,16"/>

    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
      <ComboBox x:Name="StatusFilter" Width="140" SelectionChanged="Filter_Changed">
        <ComboBoxItem Content="pending" IsSelected="True"/>
        <ComboBoxItem Content="approved"/>
        <ComboBoxItem Content="rejected"/>
      </ComboBox>
      <Button Content="Refresh" Style="{StaticResource OfficeSecondaryButton}" Margin="8,0,0,0" Click="Refresh_Click"/>
    </StackPanel>

    <DataGrid x:Name="Grid" Height="360" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeId}" Width="120"/>
        <DataGridTextColumn Header="Session" Binding="{Binding SessionId}" Width="*"/>
        <DataGridTextColumn Header="Field" Binding="{Binding FieldName}" Width="120"/>
        <DataGridTextColumn Header="Requested" Binding="{Binding RequestedValue}" Width="120"/>
        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="Approve" Style="{StaticResource OfficePrimaryButton}" Margin="0,0,8,0" Click="Approve_Click"/>
      <Button Content="Reject" Style="{StaticResource OfficeSecondaryButton}" Click="Reject_Click"/>
    </StackPanel>
    <TextBlock x:Name="StatusText" Foreground="{StaticResource OfficeMutedBrush}" Margin="0,8,0,0"/>
  </StackPanel>
</UserControl>
