<UserControl x:Class="AttendanceTracker.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel MaxWidth="640">
    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <TextBlock Text="Local data paths, backup, and engine connection." Foreground="{StaticResource OfficeMutedBrush}" Margin="0,0,0,20"/>

    <TextBlock Text="Database file" FontWeight="SemiBold"/>
    <TextBox x:Name="DbPathBox" IsReadOnly="True" Margin="0,4,0,16"/>

    <TextBlock Text="API base URL (local engine)" FontWeight="SemiBold"/>
    <TextBox x:Name="ApiUrlBox" IsReadOnly="True" Margin="0,4,0,16"/>

    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="Backup database" Style="{StaticResource OfficePrimaryButton}" Margin="0,0,8,0" Click="Backup_Click"/>
      <Button Content="Restore from backup…" Style="{StaticResource OfficeSecondaryButton}" Click="Restore_Click"/>
    </StackPanel>

    <TextBlock Text="Restoring replaces the live database. Stop agents on other PCs before restoring a central copy."
               Foreground="{StaticResource OfficeMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

    <TextBlock Text="Windows monitoring agent" FontWeight="SemiBold"/>
    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource OfficeMutedBrush}" Margin="0,4,0,0">
      Install AttendanceAgent.exe from agent-windows (publish output) on employee PCs. Set ATTENDANCE_SERVER_URL to this machine's address when using central sync.
    </TextBlock>

    <TextBlock x:Name="StatusText" Foreground="{StaticResource OfficeMutedBrush}" Margin="0,16,0,0"/>
  </StackPanel>
</UserControl>
