<UserControl x:Class="AttendanceTracker.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Attendance history" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <TextBlock Text="Search by date range, employee, and status." Foreground="{StaticResource OfficeMutedBrush}" Margin="0,0,0,16"/>

    <WrapPanel Margin="0,0,0,12">
      <StackPanel Margin="0,0,16,8">
        <TextBlock Text="From (UTC)" FontSize="12" Foreground="{StaticResource OfficeMutedBrush}"/>
        <DatePicker x:Name="FromPicker" Width="160"/>
      </StackPanel>
      <StackPanel Margin="0,0,16,8">
        <TextBlock Text="To (UTC)" FontSize="12" Foreground="{StaticResource OfficeMutedBrush}"/>
        <DatePicker x:Name="ToPicker" Width="160"/>
      </StackPanel>
      <StackPanel Margin="0,0,16,8">
        <TextBlock Text="Status" FontSize="12" Foreground="{StaticResource OfficeMutedBrush}"/>
        <ComboBox x:Name="StatusBox" Width="140">
          <ComboBoxItem Content="All" IsSelected="True"/>
          <ComboBoxItem Content="present"/>
          <ComboBoxItem Content="absent"/>
          <ComboBoxItem Content="incomplete"/>
        </ComboBox>
      </StackPanel>
      <Button Content="Search" Style="{StaticResource OfficePrimaryButton}" VerticalAlignment="Bottom" Click="Search_Click"/>
    </WrapPanel>

    <DataGrid x:Name="Grid" Height="480">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="100"/>
        <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="*"/>
        <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="120"/>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
        <DataGridTextColumn Header="Sessions" Binding="{Binding SessionCount}" Width="80"/>
        <DataGridTextColumn Header="First login (UTC)" Binding="{Binding FirstLoginUtc}" Width="180"/>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock x:Name="StatusText" Foreground="{StaticResource OfficeMutedBrush}" Margin="0,8,0,0"/>
  </StackPanel>
</UserControl>
