<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Office / Fluent-inspired palette (Segoe UI, neutral chrome, blue accent) -->
  <Color x:Key="OfficeAccentColor">#0078D4</Color>
  <Color x:Key="OfficeAccentHoverColor">#106EBE</Color>
  <Color x:Key="OfficeBgColor">#F3F2F1</Color>
  <Color x:Key="OfficeSurfaceColor">#FFFFFF</Color>
  <Color x:Key="OfficeBorderColor">#EDEBE9</Color>
  <Color x:Key="OfficeTextColor">#201F1E</Color>
  <Color x:Key="OfficeMutedColor">#605E5C</Color>
  <Color x:Key="OfficeNavSelectedColor">#E1DFDD</Color>

  <SolidColorBrush x:Key="OfficeAccentBrush" Color="{StaticResource OfficeAccentColor}"/>
  <SolidColorBrush x:Key="OfficeAccentHoverBrush" Color="{StaticResource OfficeAccentHoverColor}"/>
  <SolidColorBrush x:Key="OfficeBgBrush" Color="{StaticResource OfficeBgColor}"/>
  <SolidColorBrush x:Key="OfficeSurfaceBrush" Color="{StaticResource OfficeSurfaceColor}"/>
  <SolidColorBrush x:Key="OfficeBorderBrush" Color="{StaticResource OfficeBorderColor}"/>
  <SolidColorBrush x:Key="OfficeTextBrush" Color="{StaticResource OfficeTextColor}"/>
  <SolidColorBrush x:Key="OfficeMutedBrush" Color="{StaticResource OfficeMutedColor}"/>
  <SolidColorBrush x:Key="OfficeNavSelectedBrush" Color="{StaticResource OfficeNavSelectedColor}"/>

  <FontFamily x:Key="OfficeFont">Segoe UI, Arial, sans-serif</FontFamily>

  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="{StaticResource OfficeFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Background" Value="{StaticResource OfficeBgBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OfficeTextBrush}"/>
  </Style>

  <Style x:Key="OfficePrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource OfficeAccentBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{StaticResource OfficeAccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="OfficeSecondaryButton" TargetType="Button" BasedOn="{StaticResource OfficePrimaryButton}">
    <Setter Property="Background" Value="{StaticResource OfficeSurfaceBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OfficeTextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource OfficeBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style x:Key="OfficeNavButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="Margin" Value="4,1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource OfficeNavSelectedBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="OfficeNavButtonSelected" TargetType="Button" BasedOn="{StaticResource OfficeNavButton}">
    <Setter Property="Background" Value="{StaticResource OfficeNavSelectedBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="BorderBrush" Value="{StaticResource OfficeBorderBrush}"/>
    <Setter Property="Background" Value="{StaticResource OfficeSurfaceBrush}"/>
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="BorderBrush" Value="{StaticResource OfficeBorderBrush}"/>
    <Setter Property="Background" Value="{StaticResource OfficeSurfaceBrush}"/>
  </Style>

  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource OfficeSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource OfficeBorderBrush}"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource OfficeBorderBrush}"/>
    <Setter Property="RowBackground" Value="{StaticResource OfficeSurfaceBrush}"/>
    <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="IsReadOnly" Value="True"/>
  </Style>

</ResourceDictionary>
