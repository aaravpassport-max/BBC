  {
    "id": "f186",
    "cat": "Operator Intel",
    "factor": "OI Buildup vs Price Trap",
    "why": "OI rising sharply while price stays flat suggests large players building a position quietly - retail chasing price alone misses this",
    "weight": 3
  },
  {
    "id": "f187",
    "cat": "Operator Intel",
    "factor": "Max Pain Pull Strength",
    "why": "Near expiry, spot often gravitates toward the strike where option writers (frequently large players) lose the least - a large distance-to-max-pain plus falling time-to-expiry raises the odds of a pull toward that strike",
    "weight": 3
  },
  {
    "id": "f188",
    "cat": "Operator Intel",
    "factor": "Single-Strike OI Concentration Shift",
    "why": "A large, sudden OI change concentrated at one strike (vs spread evenly) often marks a wall being built by a large writer, not many small retail trades",
    "weight": 2
  },
  {
    "id": "f189",
    "cat": "Operator Intel",
    "factor": "Writer vs Buyer Dominance",
    "why": "Price up + OI up = long buildup (buyers in control); price down + OI up = short buildup (writers/sellers in control) - tells you who is actually driving the move, not just its direction",
    "weight": 3
  },
  {
    "id": "f190",
    "cat": "Operator Intel",
    "factor": "PCR Extremity - Retail Crowding Proxy",
    "why": "PCR far from the 0.8-1.3 neutral band suggests one-sided retail positioning (crowd extreme) - crowded trades are historically the ones large players' hedging flows can move against",
    "weight": 2
  },
  {
    "id": "f191",
    "cat": "Operator Intel",
    "factor": "FII Index Futures Positioning Skew",
    "why": "A strong FII long or short skew (from the delayed NSE participant-wise OI data) shown against retail's opposite PCR skew flags a positioning gap worth weighing, not following blindly",
    "weight": 2
  },
  {
    "id": "f192",
    "cat": "Operator Intel",
    "factor": "ATM Straddle Premium Pressure",
    "why": "Falling ATM straddle price while spot is range-bound points to net premium selling (writer-dominated); rising straddle in a flat market points to buyers paying up for a move - separate signal from price direction",
    "weight": 2
  },
  {
    "id": "f193",
    "cat": "Operator Intel",
    "factor": "Composite Operator Bias Score",
    "why": "Combines the six signals above into one directional score with a confidence label - deliberately capped in influence on the final decision so it nudges rather than overrides the other 185 factors, since this is inference from public OI/volume data, not certainty",
    "weight": 3
  }
