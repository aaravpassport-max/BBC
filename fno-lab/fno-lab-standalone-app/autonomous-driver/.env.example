# Copy this file to .env and fill in your real values.
# All values below are found on: WordPress Admin > Settings > F&O Lab Providers
# under "Autonomous Driver (Optional - genuinely unattended, browser-closed operation)"

# Your real WordPress site URL, no trailing slash. Example: https://yoursite.com
FNO_SITE_URL=

# The real, auto-generated Driver Secret shown on the settings page.
# This authenticates the driver to write real, completed trades to your
# real journal WITHOUT a browser login - keep this genuinely secret,
# the same as you would any other API credential.
FNO_DRIVER_SECRET=

# Real symbol to trade: NIFTY, BANKNIFTY, or FINNIFTY
FNO_SYMBOL=NIFTY

# Real option type fallback only — live entries follow the brain signal
# (BUY_READY→CE, SELL_READY→PE), matching the browser Autonomous Mode.
FNO_OPTION_TYPE=CE

# Real trade type for timing/FM/square-off: intraday (default), scalping, or swing
FNO_TRADING_TYPE=intraday

# Real, signed offset from the real, computed ATM strike, in real
# strike-steps. 0 = ATM, 1 = one real strike above ATM, -1 = one real
# strike below ATM.
FNO_STRIKE_OFFSET=0

# Real strike spacing for this symbol (NIFTY=50, BANKNIFTY=100, FINNIFTY=50)
FNO_STRIKE_STEP=50

# Number of exchange lots (not raw qty). Default 2 → 150 qty for NIFTY (75/lot).
# Legacy: values > 10 are treated as raw order qty (e.g. FNO_LOT_SIZE=75 for one NIFTY lot).
FNO_LOT_SIZE=2

# Real polling interval in milliseconds - how often the driver checks
# the market and evaluates a real decision. 60000 = 1 minute, matching
# the same real interval the in-browser Autonomous Mode already uses.
FNO_POLL_INTERVAL_MS=60000

# Real, optional: set to 1 to enable NSE Integration for this driver
# (Zerodha/Kite is the real, primary/main integration and is used
# regardless of this setting; this only controls the additional,
# optional NSE-direct fallback). Off by default, matching the
# browser app's own Settings panel default.
FNO_NSE_ENABLED=0

# Real, NEW this session: set to 1 to enable a real, trade-type-aware
# trailing stop for this driver's own open position (reuses the same,
# already-tested updateTrailingStop() the browser path uses - trails
# by the original risk distance, ratchets up, never retreats). Off by
# default - without this, the driver uses only the original, static
# SL set at entry, exactly its previous, pre-this-session behavior.
FNO_TRAILING_ENABLED=0
