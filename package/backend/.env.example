NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://app_user:dev_local_only@localhost:5432/logistics_superapp
JWT_ACCESS_SECRET=change_this_in_production
JWT_REFRESH_SECRET=change_this_too_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
QUOTE_TTL_SECONDS=90

# Local dev only — MUST be false in production (server refuses to boot otherwise).
ALLOW_TEST_OTP=true

# Comma-separated allowed frontend origins (REQUIRED in production)
# CORS_ORIGIN=https://app.portmystuff.com,https://driver.portmystuff.com

# Platform GST details for server-generated tax invoices
# PLATFORM_GSTIN=29AABCP1234A1Z5
# PLATFORM_LEGAL_NAME=PORTMYSTUFF Logistics Pvt Ltd
# PLATFORM_ADDRESS=Bengaluru, Karnataka, India

# Razorpay — wallet top-ups AND trip payments (card/UPI via Checkout)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# MSG91 SMS for OTP delivery (required in production)
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_OTP_TEMPLATE_ID=

# Firebase Cloud Messaging for push notifications
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON=

# Google Places (server-side proxy) — falls back to Nominatim when unset
# GOOGLE_PLACES_API_KEY=

# Exotel masked calling between customer and driver
# EXOTEL_SID=
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_CALLER_ID=

# Email (corporate invoices, notifications) — logs to console when unset
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=billing@portmystuff.com

# Routing / ETA — self-host OSRM or use a commercial endpoint in production
# OSRM_BASE_URL=https://router.project-osrm.org

# KYC / proof photo storage (mount a persistent volume in production)
# UPLOAD_DIR=/var/lib/portmystuff/uploads
