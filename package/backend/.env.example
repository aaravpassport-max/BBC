NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://app_user:dev_local_only@localhost:5432/logistics_superapp
JWT_ACCESS_SECRET=change_this_in_production
JWT_REFRESH_SECRET=change_this_too_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
QUOTE_TTL_SECONDS=90

# Fixed test phone numbers + OTP codes for physical-device testing.
# NEVER enable in production. Run `npm run seed` after migrations so the
# driver demo account is fully onboarded (KYC approved, vehicle registered).
ALLOW_TEST_OTP=true
# Optional override (defaults: 9000000001->111111 customer, 9000000002->222222 driver):
# OTP_TEST_PHONES={"9000000001":"111111","9000000002":"222222"}

# Real payment gateway (Razorpay) — optional. Wallet top-ups use a
# simulated flow when these are unset (dev-only, matching every other
# dev-only substitute in this codebase). Set all three to activate real
# payment processing with zero code changes required elsewhere — see
# src/modules/wallet/razorpay.provider.ts.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Real SMS delivery for OTP codes via MSG91 (https://msg91.com) — falls back
# to a dev-only console log when these are unset (matching every other
# dev-only substitute in this codebase). Set all three to activate real SMS
# delivery with zero code changes required elsewhere — see
# src/modules/auth/sms.provider.ts. Requires a DLT-approved SMS template
# (a separate, real registration step through MSG91's own dashboard,
# typically 1-3 business days — this is Indian telecom regulation, not
# something any code can bypass).
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_OTP_TEMPLATE_ID=

# Real push delivery via Firebase Cloud Messaging HTTP v1 API — falls back
# to a dev-only console log when these are unset (matching every other
# dev-only substitute in this codebase). Set both to activate real push
# delivery with zero code changes required elsewhere — see
# src/modules/notifications/fcm.provider.ts.
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON=
