# Copy to keystore.properties and fill in your release signing credentials.
# Generate a keystore with:
#   keytool -genkeypair -v -keystore release.keystore -alias waybill-driver \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=release.keystore
storePassword=your-store-password
keyAlias=waybill-driver
keyPassword=your-key-password
