# Vite env vars are baked in at BUILD TIME, not read at runtime — set this
# BEFORE running `npm run build && npx cap sync android`, not after.
#
# "localhost" means something different from inside the Android emulator
# than it does on your dev machine — 10.0.2.2 is the emulator's special
# alias for the HOST machine's localhost. If you're testing against a
# backend running locally on your dev machine:
VITE_API_BASE_URL=http://10.0.2.2:3000

# For a physical device on the same Wi-Fi network as your dev machine, use
# your machine's real LAN IP instead (10.0.2.2 only works in the emulator):
# VITE_API_BASE_URL=http://192.168.1.X:3000

# For a real deployed backend, use its real HTTPS URL — no emulator-IP
# workaround or network_security_config cleartext exception is needed
# once the backend is actually served over HTTPS:
# VITE_API_BASE_URL=https://api.yourdomain.com

# Show fixed demo phone + OTP on the login screen (for physical-device testing).
VITE_SHOW_TEST_CREDENTIALS=true

# Set to true after adding google-services.json and @capacitor/push-notifications.
# When false (default), synthetic device tokens are used and the app never crashes.
# VITE_ENABLE_NATIVE_PUSH=true
