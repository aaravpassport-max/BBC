{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Google Maps Scraper",
  "mainBinaryName": "Google Maps Scraper",
  "version": "1.0.0",
  "identifier": "com.googlemapsscraper.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Google Maps Scraper",
        "width": 1180,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8080 https://nominatim.openstreetmap.org; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/scraper-engine"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "shortDescription": "Google Maps business research for Windows",
    "longDescription": "Self-contained Windows desktop application for Google Maps business research, search, deduplication, and export."
  }
}
