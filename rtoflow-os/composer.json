{
    "name": "rtoflow/rtoflow-os",
    "description": "RTOFLOW OS \u2014 Enterprise RTO Service Operating Platform",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "version": "3.0.0",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "setasign/fpdf": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-phpunit/wp-phpunit": "^6.4",
        "brain/monkey": "^2.6",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "RTOFLOW\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "RTOFLOW\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-unit": "phpunit --testsuite=Unit",
        "test-integration": "phpunit --testsuite=Integration",
        "analyse": "phpstan analyse app --level=6",
        "lint": "phpcs --standard=PSR12 app/",
        "lint-fix": "phpcbf --standard=PSR12 app/",
        "lint-sql": "php tools/check-raw-queries.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}